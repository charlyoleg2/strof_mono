{
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"target": "esnext",
		"module": "NodeNext",
		"outDir": "./build",
		"types": ["node"],
		"resolveJsonModule": true,
		"moduleResolution": "NodeNext",
		"declaration": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	},
	"include": ["./src"]
}
